{
  "name": "tjb-franchise-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview": "vite preview",
    "seed": "tsx scripts/seed.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "test": "vitest run tests/unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tropical-juice \"vitest run tests/rules/firestore.rules.test.ts\"",
    "test:php": "php tests/intake.test.php",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-tropical-juice"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "firebase": "^11.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^14.26.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
