# Local emulator only. demo- project ids never contact production.
# Vite loads this file for `npm run dev` and does not use it for `npm run build`.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-tropical-juice.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-tropical-juice
VITE_FIREBASE_STORAGE_BUCKET=demo-tropical-juice.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo

VITE_USE_EMULATORS=true
VITE_REQUIRE_TOTP=false
