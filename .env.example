# Copy to .env.production and fill in the web app config from the Firebase console.
# These are public client keys (still keep the file out of git once filled in:
# .env.production is ignored). Never put a service account here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Production build: emulators off, TOTP required.
VITE_USE_EMULATORS=false
VITE_REQUIRE_TOTP=true
