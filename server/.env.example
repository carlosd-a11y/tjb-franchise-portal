# Copy to .env beside docker-compose.yml. Never commit the filled-in file.

# The Firebase project whose tokens this server will accept. Nothing else is
# taken from Firebase: no service account, no admin key, no database.
PORTAL_FIREBASE_PROJECT_ID=

# "true" refuses any token that did not pass an authenticator app. Confirm the
# claim on a real token before turning this on, and only once everyone has
# enrolled, or you will lock people out.
PORTAL_REQUIRE_TOTP=false

# Scouting platforms (Muse, Grokbot, ...) are added in the portal itself,
# under Admin -> Scouts, which generates each key. Nothing goes here.
